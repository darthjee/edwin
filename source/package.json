{
  "name": "edwin",
  "version": "0.0.1",
  "description": "Edwin RPG Game Engine – a Node.js framework for building text-based RPG web applications with React and Bootstrap",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "spec": "vitest run",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint lib spec",
    "lint_fix": "eslint lib spec --fix",
    "lint_report": "eslint . --format html --output-file report/eslint-report.html",
    "report": "jscpd lib spec --reporters console,html --output ./report/jscpd",
    "format": "prettier --write \"lib/**/*.{js,jsx,css,md}\""
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.2",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.5.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "globals": "^15.14.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "vite": "^5.2.8",
    "vitest": "^1.5.0",
    "jscpd": "4.0.8"
  },
  "keywords": [
    "rpg",
    "game-engine",
    "react",
    "bootstrap",
    "text-adventure"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
